# Supabase (browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-side token verification for /api/*)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI tutor
# Google AI Studio key (AQ. or AIza...). Gemini native auth is used automatically
# for generativelanguage.googleapis.com; set AI_GEMINI_NATIVE=true to force it.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=
# AI_GEMINI_NATIVE=false
# Comma-separated fallback models tried when the provider reports overload (429/5xx).
# Gemini defaults to: gemini-flash-lite-latest,gemini-3.1-flash-lite
# AI_FALLBACK_MODELS=

# Set to true only when /api/* is served by `vercel dev` or a deployment
VITE_ENABLE_SERVERLESS=false

# Optional Python execution (Judge0)
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
